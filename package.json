{
  "name": "nestjs-design-patterns",
  "version": "1.0.0",
  "description": "Repo mau cac Design Pattern (GoF) minh hoa bang NestJS/TypeScript",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,sample}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",

    "sample:abstract-factory": "ts-node -r tsconfig-paths/register sample/creational/abstract-factory/demo.ts",
    "sample:adapter": "ts-node -r tsconfig-paths/register sample/structural/adapter/demo.ts",
    "sample:facade": "ts-node -r tsconfig-paths/register sample/structural/facade/demo.ts",
    "sample:proxy": "ts-node -r tsconfig-paths/register sample/structural/proxy/demo.ts",
    "sample:builder": "ts-node -r tsconfig-paths/register sample/creational/builder/demo.ts",
    "sample:command": "ts-node -r tsconfig-paths/register sample/behavioral/command/demo.ts",
    "sample:decorator": "ts-node -r tsconfig-paths/register sample/structural/decorator/demo.ts",
    "sample:observer": "ts-node -r tsconfig-paths/register sample/behavioral/observer/demo.ts",
    "sample:state": "ts-node -r tsconfig-paths/register sample/behavioral/state/demo.ts",
    "sample:factory": "ts-node -r tsconfig-paths/register sample/creational/factory/demo.ts",
    "sample:singleton": "ts-node -r tsconfig-paths/register sample/creational/singleton/demo.ts",
    "sample:strategy": "ts-node -r tsconfig-paths/register sample/behavioral/strategy/demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "(sample|src)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["sample/**/*.ts", "src/**/*.ts"],
    "coveragePathIgnorePatterns": ["demo.ts", ".*without-pattern.*"],
    "testEnvironment": "node"
  }
}
